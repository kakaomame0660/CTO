//@version=6
// =============================================================================
//  MAMA 自己相関クロス ＆ 相互監視
// -----------------------------------------------------------------------------
//  MAMA       : 「MA の MA」。MA に同じ期間の MA をもう一度かけた線（自己移動平均線）
//               ※ Ehlers の MESA Adaptive Moving Average（MAMA）とは別物
//  自己相関クロス : 同じ期間の MA と MAMA のクロス
//               小矢印 = 短期（既定 5）  大矢印 = 長期（既定 20）
//  相互監視   : 2 つの自己相関クロスの向きが揃ったらその方向へ。
//               エントリー後、逆向きのクロスが出たら終了。
//               ・小→大 : 小矢印のあと大矢印を待つ → 大きく取る
//               ・大→小 : 大矢印のあと小矢印を待つ → 細かく取る
//  パターンB  : 短期MAMA と 長期MA のクロス（逆クロスで終了）
//  トレンドMA : 200MA などで「トレンドに逆らわない」ためのフィルター
// =============================================================================
indicator("MAMA 自己相関クロス（相互監視）", shorttitle = "MAMA SelfCross", overlay = true)

// ---------------------------------------------------------------- 選択肢
string T_SMA  = "SMA"
string T_EMA  = "EMA"
string T_SMMA = "SMMA (RMA)"
string T_WMA  = "WMA"
string T_SAME = "MA と同じ"

string EN_BOTH = "両方"
string EN_BIG  = "小→大（大矢印で入る＝大きく取る）"
string EN_FINE = "大→小（小矢印で入る＝細かく取る）"

string EX_ANY  = "どちらかの逆クロス（原典ルール）"
string EX_SLOW = "長期（大）の逆クロスのみ"
string EX_FAST = "短期（小）の逆クロスのみ"
string EX_AUTO = "自動（大矢印で入ったら長期／小矢印ならどちらか）"

string TF_OFF   = "OFF"
string TF_PRICE = "価格がトレンドMAの上なら買いのみ／下なら売りのみ"
string TF_SLOPE = "トレンドMAの傾きの方向のみ"

string G_MA  = "移動平均"
string G_SIG = "シグナル（相互監視）"
string G_B   = "パターンB（短期MAMA × 長期MA）"
string G_VIS = "表示"
string G_ALT = "アラート"

// ---------------------------------------------------------------- 入力
int    fastLen   = input.int(5, "短期 期間（小矢印）", minval = 1, group = G_MA)
int    slowLen   = input.int(20, "長期 期間（大矢印）", minval = 1, group = G_MA, tooltip = "5 と 20 は 40・60・80・100… と共通の倍数が多く「つぶしが効く」。5 と 100 にしても考え方は同じで、周期が長くなるだけ。")
string maType    = input.string(T_SMA, "MA の種類", options = [T_SMA, T_EMA, T_SMMA, T_WMA], group = G_MA)
string mamaSel   = input.string(T_SAME, "MAMA の種類", options = [T_SAME, T_SMA, T_EMA, T_SMMA, T_WMA], group = G_MA)
float  src       = input.source(close, "価格", group = G_MA)
bool   showTrend = input.bool(true, "トレンドMA", group = G_MA, inline = "trend")
int    trendLen  = input.int(200, "", minval = 1, group = G_MA, inline = "trend")

string entryMode = input.string(EN_BOTH, "エントリー方式", options = [EN_BOTH, EN_BIG, EN_FINE], group = G_SIG, tooltip = "小→大：小矢印が出ている状態で大矢印が出たら入る（大きく取る）。大→小：大矢印が出ている状態で小矢印が出たら入る（細かく取る）。両方：どちらでも向きが揃った時点で入る。")
string exitMode  = input.string(EX_AUTO, "決済条件", options = [EX_ANY, EX_SLOW, EX_FAST, EX_AUTO], group = G_SIG, tooltip = "自動：大矢印で入ったら長期の逆クロスまで持つ（大きく取る）、小矢印で入ったらどちらかの逆クロスで終了（細かく取る）。原典ルールは「エントリー後、どちらかの MA で逆向きクロスが出たら終了」。")
string trendMode = input.string(TF_OFF, "トレンドフィルター", options = [TF_OFF, TF_PRICE, TF_SLOPE], group = G_SIG, tooltip = "トレンドに逆らわない。トレンドMA を基準に逆方向のエントリーを出さない。")
bool   confirmed = input.bool(true, "確定足で判定（リペイントしない）", group = G_SIG)

bool   showB     = input.bool(false, "パターンB のクロスを表示", group = G_B, tooltip = "短期MAMA と 長期MA のクロス。短期MA より遅れるぶん、入った直後の戻しを食らいにくい。絶対クローズ条件は逆クロス。")

bool   showFastArr = input.bool(true, "小矢印（短期の自己相関クロス）", group = G_VIS)
bool   showSlowArr = input.bool(true, "大矢印（長期の自己相関クロス）", group = G_VIS)
bool   showEntry   = input.bool(true, "エントリー／決済マーク", group = G_VIS)
bool   showZone    = input.bool(false, "保有中の背景色", group = G_VIS)
float  gap         = input.float(0.6, "マークの間隔（ATR 倍）", minval = 0.1, step = 0.1, group = G_VIS)
bool   showDash    = input.bool(true, "状態パネル", group = G_VIS, inline = "dash")
string dashLoc     = input.string("右上", "", options = ["右上", "右下", "左上", "左下"], group = G_VIS, inline = "dash")

bool   useAlertFn  = input.bool(true, "alert() でエントリー／決済を通知", group = G_ALT, tooltip = "アラート作成時の条件で「alert() 関数の呼び出しのみ」を選ぶと、1 つのアラートでエントリーと決済をまとめて受け取れる（確定足で 1 回）。")

// ---------------------------------------------------------------- 色
color C_FAST   = #FF00FF
color C_FASTMM = #00FFFF
color C_SLOW   = #32CD32
color C_SLOWMM = #FFFF00
color C_TREND  = #FFA500
color C_UP     = #00E5FF
color C_DN     = #FF3B3B
color C_BUY    = #1E90FF
color C_SELL   = #FF4500

// ---------------------------------------------------------------- 計算
ma(float s, simple int len, simple string t) =>
    float vSma = ta.sma(s, len)
    float vEma = ta.ema(s, len)
    float vRma = ta.rma(s, len)
    float vWma = ta.wma(s, len)
    t == T_EMA ? vEma : t == T_SMMA ? vRma : t == T_WMA ? vWma : vSma

// a と b の上下関係。同値のときは直前の向きを引き継ぐ
dirOf(float a, float b, int prev) =>
    a > b ? 1 : a < b ? -1 : prev

string mamaType = mamaSel == T_SAME ? maType : mamaSel

float fastMA   = ma(src, fastLen, maType)
float fastMAMA = ma(fastMA, fastLen, mamaType)
float slowMA   = ma(src, slowLen, maType)
float slowMAMA = ma(slowMA, slowLen, mamaType)
float trendMA  = ma(src, trendLen, maType)
float atr      = ta.atr(14)

// 自己相関クロスの向き（1 = MA が MAMA の上、-1 = 下）
var int fastDir = 0
var int slowDir = 0
var int bDir    = 0
fastDir := dirOf(fastMA, fastMAMA, fastDir)
slowDir := dirOf(slowMA, slowMAMA, slowDir)
bDir    := dirOf(fastMAMA, slowMA, bDir)

bool ok = not confirmed or barstate.isconfirmed

bool fastUp = ok and fastDir == 1 and fastDir[1] == -1
bool fastDn = ok and fastDir == -1 and fastDir[1] == 1
bool slowUp = ok and slowDir == 1 and slowDir[1] == -1
bool slowDn = ok and slowDir == -1 and slowDir[1] == 1
bool bUp    = ok and bDir == 1 and bDir[1] == -1
bool bDn    = ok and bDir == -1 and bDir[1] == 1

// トレンドフィルター
bool trendUpOk = trendMode == TF_PRICE ? close > trendMA : trendMode == TF_SLOPE ? trendMA > trendMA[1] : true
bool trendDnOk = trendMode == TF_PRICE ? close < trendMA : trendMode == TF_SLOPE ? trendMA < trendMA[1] : true

// 相互監視：もう片方がすでに同じ向きのときにクロスしたら「向きが揃った」
bool longBySlow  = slowUp and fastDir == 1     // 小→大（大矢印で入る）
bool longByFast  = fastUp and slowDir == 1     // 大→小（小矢印で入る）
bool shortBySlow = slowDn and fastDir == -1
bool shortByFast = fastDn and slowDir == -1

bool useSlowTrig = entryMode != EN_FINE
bool useFastTrig = entryMode != EN_BIG
bool longTrig    = ((useSlowTrig and longBySlow) or (useFastTrig and longByFast)) and trendUpOk
bool shortTrig   = ((useSlowTrig and shortBySlow) or (useFastTrig and shortByFast)) and trendDnOk

// ポジション管理（1 = 買い、-1 = 売り、0 = なし）
var int pos     = 0
var int posKind = 0     // 1 = 大矢印で建てた、2 = 小矢印で建てた
bool exitLong  = false
bool exitShort = false

if pos == 1
    bool hitL = exitMode == EX_SLOW ? slowDn : exitMode == EX_FAST ? fastDn : (exitMode == EX_AUTO and posKind == 1) ? slowDn : (fastDn or slowDn)
    if hitL
        exitLong := true
        pos      := 0
        posKind  := 0
else if pos == -1
    bool hitS = exitMode == EX_SLOW ? slowUp : exitMode == EX_FAST ? fastUp : (exitMode == EX_AUTO and posKind == 1) ? slowUp : (fastUp or slowUp)
    if hitS
        exitShort := true
        pos       := 0
        posKind   := 0

bool goLong  = longTrig and pos != 1
bool goShort = shortTrig and pos != -1

if goLong
    if pos == -1
        exitShort := true
    pos     := 1
    posKind := useSlowTrig and longBySlow ? 1 : 2
if goShort
    if pos == 1
        exitLong := true
    pos     := -1
    posKind := useSlowTrig and shortBySlow ? 1 : 2

// ---------------------------------------------------------------- 描画：ライン
plot(fastMA, "短期MA", color = C_FAST, linewidth = 1)
plot(fastMAMA, "短期MAMA", color = C_FASTMM, linewidth = 1)
plot(slowMA, "長期MA", color = C_SLOW, linewidth = 1)
plot(slowMAMA, "長期MAMA", color = C_SLOWMM, linewidth = 1)
plot(showTrend ? trendMA : na, "トレンドMA", color = C_TREND, linewidth = 2)

// ---------------------------------------------------------------- 描画：マーク（同じ足に複数出るときは外側へ積む）
float step  = nz(atr) * gap
float yLow  = low
float yHigh = high

float yFastUp = na
float yFastDn = na
float ySlowUp = na
float ySlowDn = na
float yLong   = na
float yShort  = na

if showFastArr and fastUp
    yLow    -= step
    yFastUp := yLow
if showFastArr and fastDn
    yHigh   += step
    yFastDn := yHigh
if showSlowArr and slowUp
    yLow    -= step
    ySlowUp := yLow
if showSlowArr and slowDn
    yHigh   += step
    ySlowDn := yHigh
if showEntry and goLong
    yLow  -= step * 1.2
    yLong := yLow
if showEntry and goShort
    yHigh  += step * 1.2
    yShort := yHigh

float yExit = showEntry and (exitLong or exitShort) ? close : na
float yBUp  = showB and bUp ? (fastMAMA + slowMA) / 2 : na
float yBDn  = showB and bDn ? (fastMAMA + slowMA) / 2 : na

plotchar(yFastUp, title = "小矢印↑", char = "⇧", location = location.absolute, color = C_UP, size = size.small)
plotchar(yFastDn, title = "小矢印↓", char = "⇩", location = location.absolute, color = C_DN, size = size.small)
plotshape(ySlowUp, title = "大矢印↑", style = shape.arrowup, location = location.absolute, color = C_UP, size = size.small)
plotshape(ySlowDn, title = "大矢印↓", style = shape.arrowdown, location = location.absolute, color = C_DN, size = size.small)
plotshape(yLong, title = "買いエントリー", style = shape.labelup, location = location.absolute, color = C_BUY, text = "買い", textcolor = color.white, size = size.small)
plotshape(yShort, title = "売りエントリー", style = shape.labeldown, location = location.absolute, color = C_SELL, text = "売り", textcolor = color.white, size = size.small)
plotshape(yExit, title = "決済", style = shape.xcross, location = location.absolute, color = color.silver, size = size.tiny)
plotchar(yBUp, title = "パターンB↑", char = "○", location = location.absolute, color = C_UP, size = size.small)
plotchar(yBDn, title = "パターンB↓", char = "○", location = location.absolute, color = C_DN, size = size.small)

bgcolor(showZone and pos == 1 ? color.new(C_BUY, 90) : showZone and pos == -1 ? color.new(C_SELL, 90) : na, title = "保有中")

// ---------------------------------------------------------------- 状態パネル
dirText(int d) =>
    d == 1 ? "▲ 上" : d == -1 ? "▼ 下" : "―"

dirColor(int d) =>
    d == 1 ? C_UP : d == -1 ? C_DN : color.gray

string dashPosition = dashLoc == "右下" ? position.bottom_right : dashLoc == "左上" ? position.top_left : dashLoc == "左下" ? position.bottom_left : position.top_right
var table dash = table.new(dashPosition, 2, 6, bgcolor = color.new(#000000, 20), frame_color = color.new(#808080, 40), frame_width = 1, border_color = color.new(#808080, 70), border_width = 1)

if showDash and barstate.islast
    int    align    = fastDir == slowDir ? fastDir : 0
    string alignTxt = align == 1 ? "買い方向で一致" : align == -1 ? "売り方向で一致" : "不一致（待ち）"
    int    trendDir = trendMode == TF_SLOPE ? (trendMA > trendMA[1] ? 1 : trendMA < trendMA[1] ? -1 : 0) : (close > trendMA ? 1 : close < trendMA ? -1 : 0)
    string trendTxt = trendMode == TF_SLOPE ? (trendDir == 1 ? "MA 上向き" : trendDir == -1 ? "MA 下向き" : "―") : (trendDir == 1 ? "価格 > MA" : trendDir == -1 ? "価格 < MA" : "―")
    string posTxt   = pos == 1 ? "買い保有中" : pos == -1 ? "売り保有中" : "ノーポジ"
    color  posCol   = pos == 1 ? C_BUY : pos == -1 ? C_SELL : color.gray

    table.cell(dash, 0, 0, "MAMA", text_color = color.white, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 0, str.tostring(fastLen) + " / " + str.tostring(slowLen), text_color = color.white, text_size = size.small)
    table.cell(dash, 0, 1, "小（" + str.tostring(fastLen) + "）", text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 1, dirText(fastDir), text_color = dirColor(fastDir), text_size = size.small)
    table.cell(dash, 0, 2, "大（" + str.tostring(slowLen) + "）", text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 2, dirText(slowDir), text_color = dirColor(slowDir), text_size = size.small)
    table.cell(dash, 0, 3, "相互監視", text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 3, alignTxt, text_color = dirColor(align), text_size = size.small)
    table.cell(dash, 0, 4, "トレンド（" + str.tostring(trendLen) + "）", text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 4, trendTxt, text_color = dirColor(trendDir), text_size = size.small)
    table.cell(dash, 0, 5, "ポジション", text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 5, posTxt, text_color = posCol, text_size = size.small)

// ---------------------------------------------------------------- アラート
alertcondition(fastUp, "小矢印↑（短期 自己相関クロス 上）", "{{ticker}} {{interval}} 小矢印↑：短期MA が 短期MAMA を上抜け")
alertcondition(fastDn, "小矢印↓（短期 自己相関クロス 下）", "{{ticker}} {{interval}} 小矢印↓：短期MA が 短期MAMA を下抜け")
alertcondition(slowUp, "大矢印↑（長期 自己相関クロス 上）", "{{ticker}} {{interval}} 大矢印↑：長期MA が 長期MAMA を上抜け")
alertcondition(slowDn, "大矢印↓（長期 自己相関クロス 下）", "{{ticker}} {{interval}} 大矢印↓：長期MA が 長期MAMA を下抜け")
alertcondition(goLong, "買いエントリー（相互監視）", "{{ticker}} {{interval}} 買いエントリー：2 つの自己相関クロスが上で一致")
alertcondition(goShort, "売りエントリー（相互監視）", "{{ticker}} {{interval}} 売りエントリー：2 つの自己相関クロスが下で一致")
alertcondition(exitLong, "買い決済", "{{ticker}} {{interval}} 買い決済：逆向きの自己相関クロス")
alertcondition(exitShort, "売り決済", "{{ticker}} {{interval}} 売り決済：逆向きの自己相関クロス")
alertcondition(goLong or goShort or exitLong or exitShort, "エントリー／決済（すべて）", "{{ticker}} {{interval}} MAMA 相互監視シグナル")
alertcondition(bUp, "パターンB↑（短期MAMA × 長期MA 上抜け）", "{{ticker}} {{interval}} パターンB↑：短期MAMA が 長期MA を上抜け")
alertcondition(bDn, "パターンB↓（短期MAMA × 長期MA 下抜け）", "{{ticker}} {{interval}} パターンB↓：短期MAMA が 長期MA を下抜け")

if useAlertFn
    string msg = ""
    if exitLong
        msg := msg + "買い決済 "
    if exitShort
        msg := msg + "売り決済 "
    if goLong
        msg := msg + "買いエントリー "
    if goShort
        msg := msg + "売りエントリー "
    if str.length(msg) > 0
        alert(syminfo.ticker + " " + timeframe.period + " MAMA相互監視：" + msg, alert.freq_once_per_bar_close)
